# =========================
# GNU Radio Channel Emulator
# Émule : FSPL + single-tap multipath + AWGN + Doppler
# Conforme papier REAL (arXiv:2502.00715), section III-B
# Distance aléatoire d ∈ [0.5 km, 2 km]
# =========================

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    gnuradio \
    python3-numpy \
    python3-scipy \
    python3-zmq \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir pyzmq numpy scipy

WORKDIR /app
COPY resources/channel_emulator.py /app/channel_emulator.py

ENV GNB_ZMQ_TX_ADDR="tcp://srsran-gnb:2000"
ENV GNB_ZMQ_RX_ADDR="tcp://srsran-gnb:2001"
ENV UE_ZMQ_TX_ADDR="tcp://srsue:2100"
ENV UE_ZMQ_RX_ADDR="tcp://srsue:2101"
ENV DISTANCE_MIN_KM="0.5"
ENV DISTANCE_MAX_KM="2.0"
ENV DOPPLER_MAX_HZ="50"
ENV NOISE_FIGURE_DB="7"

CMD ["python3", "/app/channel_emulator.py"]
